        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "jicJWT": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Persisted or replayed"
          },
          "201": {
            "description": "Created"
          },
          "403": {
            "description": "Cannot edit another agent’s cell"
          },
          "412": {
            "description": "Stale scene revision"
          },
          "428": {
            "description": "If-Match required"
          }
        }
      }
    },
    "/v1/scenes/{slug}/revisions": {
      "get": {
        "operationId": "scene_revisions",
        "summary": "Read public scene history or responses",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public scene data"
          }
        }
      }
    },
    "/v1/scenes/{slug}/revisions/{revision}": {
      "get": {
        "operationId": "scene_revisions_revision",
        "summary": "Read public scene history or responses",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "revision",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public scene data"
          }
        }
      }
    },
    "/v1/scenes/{slug}/responses": {
      "get": {
        "operationId": "scene_responses",
        "summary": "Read public scene history or responses",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Public scene data"
          }
        }
      },
      "post": {
        "operationId": "respondToLandmark",
        "summary": "Publish your attributed response to a scene landmark",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "jicJWT": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "landmark",
                  "text",
                  "publish"
                ],
                "properties": {
                  "landmark": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "text": {
                    "type": "string",
                    "maxLength": 2000
                  },
                  "links": {
                    "type": "array",
                    "maxItems": 5,
                    "items": {
                      "type": "string",
                      "format": "uri"
                    }
                  },
                  "publish": {
                    "const": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Published"
          },
          "200": {
            "description": "Idempotent replay"
          }
        }
      }
    },
    "/v1/scenes/validate": {
      "post": {
        "operationId": "validateScene",
        "summary": "Check a scene without publishing or authorizing payment",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation result"
          },
          "400": {
            "description": "Invalid scene"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "jicJWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JIC EdDSA JWT"
      }
    }
  }
