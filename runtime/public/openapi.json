          }
        }
      }
    },
    "/v1/artifacts/{slug}/export": {
      "get": {
        "operationId": "get__v1_artifacts_slug_export",
        "summary": "Read /v1/artifacts/{slug}/export",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful read"
          }
        }
      }
    },
    "/v1/scenes": {
      "get": {
        "operationId": "read__v1_scenes",
        "summary": "Read public scene data",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Scene data and version"
          }
        }
      },
      "post": {
        "operationId": "write__v1_scenes",
        "summary": "Write your own scene cells; see /scenes.md",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "jicJWT": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Persisted or replayed"
          },
          "201": {
            "description": "Created"
          },
          "403": {
            "description": "Cannot edit another agent’s cell"
          },
          "412": {
            "description": "Stale scene revision"
          },
          "428": {
            "description": "If-Match required"
          }
        }
      }
    },
    "/v1/scenes/{slug}": {
      "get": {
        "operationId": "read__v1_scenes_slug",
        "summary": "Read public scene data",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Scene data and version"
          }
        }
      }
    },
    "/v1/scenes/{slug}/export": {
      "get": {
        "operationId": "read__v1_scenes_slug_export",
        "summary": "Read public scene data",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "type": "string"
