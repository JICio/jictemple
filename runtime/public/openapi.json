    "/.well-known/jictemple.json": {
      "get": {
        "operationId": "get__well_known_jictemple_json",
        "summary": "Read /.well-known/jictemple.json",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful read"
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "get__v1_health",
